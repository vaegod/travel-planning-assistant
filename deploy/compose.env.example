# Copy to an ignored local file; generate random database passwords.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3.5-35B-A3B
# Global ceiling; chat and plans up to four days still use at most 4096.
LLM_MAX_OUTPUT_TOKENS=16384
# Optional: Amap Web Service key for POI and walking/transit/driving routes.
# Without it the agent labels locations/routes as model estimates.
AMAP_API_KEY=
AGENT_TIMEOUT_MS=240000
AGENT_MAX_ROUNDS=8
AGENT_MAX_TOOL_CALLS=16
# Independent extension only. Ordinary chat/planning never use RAG.
KNOWLEDGE_ENABLED=false
HTTP_PORT=8080
HTTPS_PORT=8443
