# Copy to .env in this directory; never commit the real key.
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3.5-35B-A3B
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=120
# Global ceiling; ordinary chat and plans of up to 4 days still request at most 4096.
LLM_MAX_OUTPUT_TOKENS=16384
# Optional knowledge extension. Leave disabled for ordinary chat and planning.
KNOWLEDGE_ENABLED=false
# Embeddings reuse LLM_API_KEY; base URL defaults to LLM_BASE_URL when omitted.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RAG_MIN_SCORE=0.55
DB_URL=jdbc:mysql://127.0.0.1:3306/travel_ai?serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
DB_TEST_URL=jdbc:mysql://127.0.0.1:3306/travel_ai_test?serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=travel_ai_app
DB_PASSWORD=
DB_MANAGED_WSL=false
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
OSRM_URL=https://router.project-osrm.org
PLANNING_CACHE_DIR=.planning-cache
